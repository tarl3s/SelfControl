<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SelfControl.App.MainWindow" Title="SelfControl" Width="960" Height="640" MinWidth="640" MinHeight="420"
        Background="{DynamicResource Bg0}">
  <DockPanel>
    <Border x:Name="LoadFailedBanner" DockPanel.Dock="Top" Background="#FFFFFF" Padding="12,8" IsVisible="False">
      <TextBlock x:Name="LoadFailedText" Foreground="#000000" FontWeight="SemiBold"/>
    </Border>
    <Border DockPanel.Dock="Left" Width="200" Background="{DynamicResource Bg1}">
      <DockPanel>
      <Button x:Name="Gear" DockPanel.Dock="Bottom" Margin="8" HorizontalAlignment="Stretch"/>
      <StackPanel x:Name="UsagePanel" DockPanel.Dock="Bottom" Margin="16,0,16,4" Spacing="2" Background="Transparent">
        <TextBlock x:Name="UsageLabel" FontSize="12" Foreground="#9A9A9A"/>
        <TextBlock x:Name="UsageText" FontSize="20" FontWeight="SemiBold"/>
      </StackPanel>
      <ListBox x:Name="Nav" Background="Transparent" Margin="8" SelectedIndex="0">
        <ListBoxItem x:Name="NavHome"/>
        <ListBoxItem x:Name="NavRoutine"/>
        <ListBoxItem x:Name="NavEvents"/>
        <ListBoxItem x:Name="NavTasks"/>
      </ListBox>
      </DockPanel>
    </Border>
    <ContentControl x:Name="Host" Background="{DynamicResource Bg0}"/>
  </DockPanel>
</Window>
