<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SelfControl.App.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SelfControl.App/Theme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme/>
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Bg0}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Selection}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnSelection}"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Selection}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnSelection}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E6E6E6"/>
      <Setter Property="Foreground" Value="#000000"/>
    </Style>
  </Application.Styles>
</Application>
